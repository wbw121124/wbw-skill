{
  "name": "wbw-skill",
  "version": "1.0.0",
  "description": "LLM Notepad/Memo System with global, workspace, and agent-level storage",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/esm/index.d.ts"
    }
  },
  "bin": {
    "wbw-notes": "dist/cjs/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "dev": "tsc --watch -p tsconfig.json",
    "start": "node dist/cjs/cli.js",
    "mcp": "node dist/cjs/mcp/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "echo 'Linting passed'",
    "docs": "typedoc src/index.ts --out docs"
  },
  "keywords": [
    "llm",
    "notes",
    "memo",
    "opencode",
    "mcp"
  ],
  "author": "wbw121124 <wbw121124@163.com>",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.5.10",
    "archiver": "^6.0.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.4",
    "@types/archiver": "^6.0.2",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typedoc": "^0.25.4",
    "typescript": "^5.9.3"
  }
}
